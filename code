    e.preventDefault();
    var row = state.selected;
    if (!row) return;
    var c = CLASSES[row.cid];
    if (!validate(c)) return;
    if (capOf(row) - baseBooked(row) - taken(row.sid) <= 0) {
      $("formErr").textContent = "This class has just filled up. Close this window and pick another.";
      return;
    }
    var btn = $("submitBtn");
    btn.disabled = true;
    btn.textContent = "Booking…";
    var ref = makeRef();
    var shared = false;
    if (state.db) {
      try {
        await state.db.doc("taken/" + ref).set({ s: row.sid, t: Date.now() });
        shared = true;
      } catch (err) { shared = false; }
    }
    var b = { ref: ref, sid: row.sid, cid: row.cid, dow: row.dow, hm: row.hm, end: row.end, child: $("f-child").value.trim(), age: parseInt($("f-age").value, 10), shared: shared };
    state.bookings.push(b);
    saveBookings();
    renderAll();
    showDone(b, c, $("f-parent").value.trim());
  }
  function showDone(b, c, parent) {
    $("doneRef").textContent = b.ref;
    var dl = $("doneFacts");
    dl.textContent = "";
    [["Class", c.name], ["When", "Every " + FULL_DAYS[b.dow] + ", " + b.hm + "–" + b.end], ["Gymnast", b.child + ", age " + b.age], ["Booked by", parent], ["Fee", money(c.price) + " per month"]].forEach(function (r) {
      dl.append(h("dt", {}, r[0]), h("dd", {}, r[1]));
    });
    $("doneNote").textContent = b.shared
      ? "Keep this reference. Your place is counted in the shared timetable and saved on this device. No payment has been taken."
      : "Keep this reference. The place is saved on this device only, so it is not yet counted in the shared timetable. No payment has been taken.";
    $("viewForm").hidden = true;
    $("viewDone").hidden = false;
    $("doneBtn").focus();
  }
  $("form").addEventListener("submit", submit);
  $("cancelBtn").addEventListener("click", closeDialog);
  $("closeA").addEventListener("click", closeDialog);
  $("closeB").addEventListener("click", closeDialog);
  $("doneBtn").addEventListener("click", closeDialog);
  dlg.addEventListener("click", function (ev) { if (ev.target === dlg) closeDialog(); });

  /* shared place counts (anonymous markers only) */
  async function initDb() {
    try {
      if (!window.claude || !window.claude.use) return;
      var db = await window.claude.use("db");
      if (!db) return;
      state.db = db;
      db.collection("taken").onSnapshot(function (snap) {
        var c = {};
        snap.docs.forEach(function (d) {
          var v = d.data();
          if (v && v.s) c[v.s] = (c[v.s] || 0) + 1;
        });
        var key = JSON.stringify(c);
        var changed = key !== state.countsKey || !state.dbReady;
        state.counts = c;
        state.countsKey = key;
        state.dbReady = true;
        if (changed) renderAll();
      }, function () {
        state.db = null;
        state.dbReady = false;
        renderAll();
      });
    } catch (err) {}
  }

  state.bookings = loadBookings();
  renderChips();
  renderInfo();
  renderAll();
  var start = (location.hash || "").replace("#", "");
  show(VIEWS.indexOf(start) >= 0 ? start : "home");
  initDb();
})();
</script>

