<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Gym Slot</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Figtree:wght@400;500;600;700&display=swap">
<style>
/* Layout: three views in one page (home, clubs, a club's bookings). Navy header band, cream page, gold hairlines taken from the club's own timetable and logo. */
:root {
  --display: "Poppins", "Helvetica Neue", Arial, sans-serif;
  --body: "Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
  --navy: #011D44;
  --gold: #CBAC6C;
  --bg: #F7F4EC;
  --surface: #FFFFFF;
  --fg: #0B1B38;
  --muted: #4F5C75;
  --line: #E3DAC4;
  --soft: #EFE7D2;
  --gold-ink: #7A5B16;
  --btn: #011D44;
  --btn-fg: #FFFFFF;
  --band-link: #F2EBD8;
  --ok-bg: #DDF3E4;
  --ok-fg: #14532D;
  --warn-bg: #FCEBC7;
  --warn-fg: #6B3F00;
  --out-bg: #E4E8EF;
  --out-fg: #475268;
  --danger: #B3261E;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #000F26;
    --surface: #0A2550;
    --fg: #F1ECDD;
    --muted: #A9B4CB;
    --line: #1D3A6C;
    --soft: #10305F;
    --gold-ink: #D9BC7E;
    --btn: #CBAC6C;
    --btn-fg: #011D44;
    --band-link: #F2EBD8;
    --ok-bg: #123A25;
    --ok-fg: #9BE3B5;
    --warn-bg: #4A3510;
    --warn-fg: #F5CF85;
    --out-bg: #1C2840;
    --out-fg: #A9B4CB;
    --danger: #FF8A80;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #000F26;
  --surface: #0A2550;
  --fg: #F1ECDD;
  --muted: #A9B4CB;
  --line: #1D3A6C;
  --soft: #10305F;
  --gold-ink: #D9BC7E;
  --btn: #CBAC6C;
  --btn-fg: #011D44;
  --band-link: #F2EBD8;
  --ok-bg: #123A25;
  --ok-fg: #9BE3B5;
  --warn-bg: #4A3510;
  --warn-fg: #F5CF85;
  --out-bg: #1C2840;
  --out-fg: #A9B4CB;
  --danger: #FF8A80;
  color-scheme: dark;
}

*, *::before, *::after { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg); font: 400 16px/1.55 var(--body); -webkit-text-size-adjust: 100%; }
h1, h2, h3, p, ul, ol, dl, dd { margin: 0; }
ul, ol { padding: 0; list-style: none; }
a { color: inherit; }
:focus-visible { outline: 3px solid var(--btn); outline-offset: 2px; }
.band :focus-visible, .clubhero :focus-visible { outline-color: var(--gold); }
[hidden] { display: none !important; }

.wrap {
  width: 100%;
  max-width: 860px;
  margin-inline: auto;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
}

/* header */
.band { background: var(--navy); color: var(--band-link); }
.band .wrap { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-block: 14px; }
.brand { font: 800 1.5rem/1 var(--display); letter-spacing: -0.01em; color: var(--gold); text-decoration: none; }
.nav { display: flex; gap: 6px; }
.nav a { font-weight: 600; font-size: 0.95rem; text-decoration: none; padding: 8px 12px; border-radius: 6px; color: var(--band-link); }
.nav a[aria-current="page"] { background: rgba(203, 172, 108, 0.18); color: var(--gold); }

/* home */
.hero { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; padding-block: 56px 36px; }
.hero h1 { font: 800 clamp(3.6rem, 15vw, 7.2rem)/0.9 var(--display); letter-spacing: -0.035em; color: var(--fg); }
.rules { width: 112px; height: 7px; border-top: 1.5px solid var(--gold); border-bottom: 1.5px solid var(--gold); }
.hero p { font-size: 1.15rem; color: var(--muted); max-width: 32ch; text-wrap: pretty; }
.steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding-block: 8px 72px; }
.step { display: flex; flex-direction: column; gap: 6px; padding: 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
.step b { font: 800 1.8rem/1 var(--display); color: var(--gold-ink); }
.step span { font-weight: 600; }
.step small { color: var(--muted); font-size: 0.9rem; }

/* buttons */
.btn { display: inline-flex; align-items: center; justify-content: center; font: 600 0.98rem var(--body); min-height: 44px; padding: 0 22px; border-radius: 6px; border: 1.5px solid var(--btn); background: var(--btn); color: var(--btn-fg); cursor: pointer; text-decoration: none; }
.btn:disabled { background: var(--out-bg); border-color: var(--out-bg); color: var(--out-fg); cursor: not-allowed; }
.btn.ghost { background: transparent; color: var(--fg); border-color: var(--line); }
.btn.danger { background: transparent; border-color: var(--danger); color: var(--danger); }
.btn.sm { min-height: 40px; padding: 0 18px; }

/* page titles */
.pagehead { display: flex; flex-direction: column; gap: 10px; padding-block: 36px 20px; }
.pagehead h1 { font: 800 clamp(2.2rem, 8vw, 3.2rem)/1 var(--display); letter-spacing: -0.02em; }
.pagehead p { color: var(--muted); max-width: 46ch; }
.back { align-self: flex-start; font-weight: 600; font-size: 0.92rem; color: var(--gold-ink); text-decoration: none; padding-block: 4px; }
.back:hover { text-decoration: underline; }

/* clubs */
.clubs { display: flex; flex-direction: column; gap: 12px; padding-bottom: 72px; }
.club { display: flex; align-items: center; gap: 16px; padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; text-decoration: none; }
.club:hover { border-color: var(--gold); }
.club img { flex: none; width: 84px; height: 84px; border-radius: 6px; display: block; }
.club .txt { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.club .nm { font: 700 1.2rem/1.2 var(--display); }
.club .loc { font-weight: 600; font-size: 0.9rem; color: var(--gold-ink); }
.club .ds { font-size: 0.92rem; color: var(--muted); }
.club .go { flex: none; font-weight: 700; font-size: 1.4rem; color: var(--gold-ink); padding-right: 6px; }
.more { padding: 18px; border: 1px dashed var(--line); border-radius: 8px; color: var(--muted); }

/* club bookings */
.clubhero { background: var(--navy); border-bottom: 1px solid rgba(203, 172, 108, 0.35); }
.clubhero .wrap { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding-block: 18px 22px; }
.clubhero .back { color: var(--gold); }
.clubhero img { display: block; width: min(440px, 100%); height: auto; }

.keybox { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 24px; margin-top: 22px; padding: 14px 16px; background: var(--soft); border: 1px solid var(--gold); border-radius: 8px; font-size: 0.9rem; }
.keybox h2 { grid-column: 1 / -1; font: 700 0.78rem var(--body); letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold-ink); }
.keybox dl { display: grid; grid-template-columns: auto 1fr; gap: 3px 12px; }
.keybox dt { font-weight: 600; }
.keybox dd { color: var(--muted); }
.keybox p { grid-column: 1 / -1; color: var(--muted); }
.keybox + .keybox { margin-top: 12px; }
.fees dd { color: var(--fg); font-weight: 600; font-variant-numeric: tabular-nums; }

.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
.chip { font: 600 0.9rem var(--body); min-height: 40px; padding: 0 15px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--surface); color: var(--fg); cursor: pointer; }
.chip[aria-pressed="true"] { background: var(--btn); border-color: var(--btn); color: var(--btn-fg); }
.chiplabel { margin-top: 22px; font: 700 0.75rem var(--body); letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold-ink); }
.chiplabel + .chips { margin-top: 8px; }
.class-info { margin-top: 10px; color: var(--muted); font-size: 0.95rem; min-height: 1.55em; }

.day { display: flex; flex-direction: column; gap: 8px; margin-top: 26px; }
.day h2 { display: flex; align-items: baseline; gap: 10px; font: 700 1.3rem/1.1 var(--display); padding-bottom: 6px; border-bottom: 1.5px solid var(--gold); }
.day h2 .tag { font: 700 0.7rem var(--body); letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold-ink); }
.day ul { display: flex; flex-direction: column; gap: 8px; }

.sess { display: grid; grid-template-columns: 4.6rem minmax(0, 1fr) auto; gap: 6px 14px; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px; }
.when .t { display: block; font: 700 1.35rem/1.05 var(--display); font-variant-numeric: tabular-nums; }
.when .d { display: block; margin-top: 2px; font-size: 0.78rem; color: var(--muted); font-variant-numeric: tabular-nums; }
.what { min-width: 0; }
.what .name { font-weight: 700; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 10px; }
.what .price { font-weight: 700; font-size: 0.85rem; color: var(--gold-ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
.what .meta { font-size: 0.875rem; color: var(--muted); }
.what .next { margin-top: 2px; font-size: 0.8rem; color: var(--gold-ink); font-weight: 600; }
.act { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 10px; }
.pill { font: 600 0.78rem var(--body); padding: 4px 10px; border-radius: 999px; white-space: nowrap; font-variant-numeric: tabular-nums; }
.pill.ok { background: var(--ok-bg); color: var(--ok-fg); }
.pill.warn { background: var(--warn-bg); color: var(--warn-fg); }
.pill.out { background: var(--out-bg); color: var(--out-fg); }
.empty { margin-top: 24px; padding: 20px; background: var(--surface); border: 1px dashed var(--line); border-radius: 6px; color: var(--muted); }

.mine { margin-top: 48px; padding-bottom: 72px; display: flex; flex-direction: column; gap: 10px; }
.mine h2 { font: 700 1.3rem/1.1 var(--display); padding-bottom: 6px; border-bottom: 1.5px solid var(--gold); }
.mine .sub { color: var(--muted); font-size: 0.9rem; }
.mine ul { display: flex; flex-direction: column; gap: 8px; }
.mine li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px; }
.mine .info { min-width: 0; }
.mine .info .name { font-weight: 700; }
.mine .info .meta { font-size: 0.875rem; color: var(--muted); }
.refcode { font-variant-numeric: tabular-nums; letter-spacing: 0.08em; font-weight: 700; }
.sessions-end { padding-bottom: 8px; }

.tabs { display: flex; gap: 6px; margin-top: 18px; border-bottom: 1.5px solid var(--line); }
.tab { font: 600 0.95rem var(--body); min-height: 44px; padding: 0 16px; background: transparent; border: 0; border-bottom: 3px solid transparent; margin-bottom: -1.5px; color: var(--muted); cursor: pointer; }
.tab[aria-selected="true"] { color: var(--fg); border-bottom-color: var(--gold); }

.contact { display: flex; flex-direction: column; gap: 10px; padding-bottom: 72px; }
.contact h2 { font: 700 1.3rem/1.1 var(--display); padding-bottom: 6px; border-bottom: 1.5px solid var(--gold); }
.crow { display: grid; grid-template-columns: 6rem minmax(0, 1fr) auto; gap: 6px 14px; align-items: center; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 12px 14px; }
.crow .k { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--gold-ink); }
.crow .v { min-width: 0; overflow-wrap: anywhere; font-weight: 600; font-style: normal; }
.crow .v a { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 3px; }
.crow .acts { display: flex; flex-wrap: wrap; gap: 8px; }

/* booking dialog */
dialog { border: 0; padding: 0; border-radius: 10px; background: var(--surface); color: var(--fg); width: min(540px, calc(100% - 24px)); max-height: calc(100% - 24px); box-shadow: 0 24px 70px rgba(0, 0, 0, 0.4); }
dialog::backdrop { background: rgba(1, 10, 28, 0.66); }
.dlg { display: flex; flex-direction: column; gap: 14px; padding: 20px 20px 22px; }
.dlg-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.dlg h2 { font: 800 1.6rem/1.1 var(--display); letter-spacing: -0.01em; }
.x { flex: none; width: 40px; height: 40px; border-radius: 6px; border: 1.5px solid var(--line); background: transparent; color: var(--fg); font-size: 1.1rem; line-height: 1; cursor: pointer; }
.sum { background: var(--soft); border-left: 3px solid var(--gold); border-radius: 4px; padding: 10px 12px; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
.sum strong { font-weight: 700; }
.fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.field { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
.field.full { grid-column: 1 / -1; }
.field label { font-weight: 600; font-size: 0.9rem; }
.field input[type="text"], .field input[type="email"], .field input[type="number"] { font: 400 16px var(--body); min-height: 44px; padding: 0 12px; border-radius: 6px; border: 1.5px solid var(--line); background: var(--bg); color: var(--fg); width: 100%; }
.field select { font: 400 16px var(--body); min-height: 44px; padding: 0 10px; border-radius: 6px; border: 1.5px solid var(--line); background: var(--bg); color: var(--fg); width: 100%; }
.field input[aria-invalid="true"] { border-color: var(--danger); }
.err { color: var(--danger); font-size: 0.85rem; min-height: 1.2em; }
.check { display: flex; align-items: flex-start; gap: 10px; font-size: 0.92rem; font-weight: 400; }
.check input { flex: none; width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--btn); }
.form-err { color: var(--danger); font-size: 0.92rem; min-height: 1.3em; }
.dlg-actions { display: flex; flex-wrap: wrap; gap: 10px; }
.ref { font: 800 2.4rem/1 var(--display); letter-spacing: 0.05em; color: var(--gold-ink); }
.facts { display: grid; grid-template-columns: auto 1fr; gap: 6px 16px; font-size: 0.95rem; }
.facts dt { color: var(--muted); }
.facts dd { font-weight: 600; min-width: 0; overflow-wrap: anywhere; }
.note { color: var(--muted); font-size: 0.9rem; }

@media (max-width: 600px) {
  .steps { grid-template-columns: 1fr; }
  .keybox { grid-template-columns: 1fr; }
}
@media (max-width: 520px) {
  .sess { grid-template-columns: 4rem minmax(0, 1fr); }
  .act { grid-column: 1 / -1; justify-content: space-between; }
  .fields { grid-template-columns: 1fr; }
  .club img { width: 68px; height: 68px; }
  .crow { grid-template-columns: minmax(0, 1fr) auto; }
  .crow .k { grid-column: 1 / -1; }
  .hero { padding-block: 40px 28px; }
}
@media (prefers-reduced-motion: reduce) { * { scroll-behavior: auto !important; } }
</style>
</head>
<body>

<header class="band">
  <div class="wrap">
    <a class="brand" href="#home" data-go="home">Gym Slot</a>
    <nav class="nav" aria-label="Main">
      <a href="#home" data-go="home" data-nav="home">Home</a>
      <a href="#clubs" data-go="clubs" data-nav="clubs">Clubs</a>
    </nav>
  </div>
</header>

<!-- HOME -->
<main data-view="home">
  <div class="wrap">
    <section class="hero">
      <h1>Gym Slot</h1>
      <div class="rules" aria-hidden="true"></div>
      <p>Book gymnastics classes at your local club.</p>
      <a class="btn" href="#clubs" data-go="clubs">Find a club</a>
    </section>
    <ol class="steps" aria-label="How booking works">
      <li class="step"><b>1</b><span>Choose a club</span><small>See which clubs you can book with.</small></li>
      <li class="step"><b>2</b><span>Pick a class</span><small>Browse the weekly timetable by day.</small></li>
      <li class="step"><b>3</b><span>Reserve a place</span><small>Add the gymnast's details and book.</small></li>
    </ol>
  </div>
</main>

<!-- CLUBS -->
<main data-view="clubs" hidden>
  <div class="wrap">
    <section class="pagehead">
      <h1>Clubs you can book</h1>
      <p>Choose a club to see its classes and book a place.</p>
    </section>
    <div class="clubs">
      <a class="club" href="#gga" data-go="gga">
        <img src="data:image/png;base64," alt="" width="84" height="84">
        <span class="txt">
          <span class="nm">Glasgow Gymnastics Academy</span>
          <span class="loc">Thornliebank, Glasgow</span>
          <span class="ds">Parent &amp; toddler, preschool, recreational, squads and acro.</span>
        </span>
        <span class="go" aria-hidden="true">&rarr;</span>
      </a>
      <p class="more">More clubs will appear here.</p>
    </div>
  </div>
</main>

<!-- CLUB: GLASGOW GYMNASTICS ACADEMY -->
<main data-view="gga" hidden>
  <div class="clubhero">
    <div class="wrap">
      <a class="back" href="#clubs" data-go="clubs">&larr; All clubs</a>
      <img src="data:image/png;base64," alt="Glasgow Gymnastics Academy" width="1000" height="248">
    </div>
  </div>
  <div class="wrap">
    <div class="tabs" role="tablist" aria-label="Club sections">
      <button type="button" class="tab" role="tab" id="tabBook" aria-selected="true" aria-controls="paneBook">Book a class</button>
      <button type="button" class="tab" role="tab" id="tabAbout" aria-selected="false" aria-controls="paneAbout">About</button>
    </div>
    <div id="paneBook" role="tabpanel" aria-labelledby="tabBook">
    <section class="pagehead">
      <h1>Book a class</h1>
      <p>The weekly timetable. Pick a day or see every day, then choose a class and the date you want to start. Times are Glasgow time.</p>
    </section>

    <section class="keybox" aria-labelledby="keyTitle">
      <h2 id="keyTitle">Key</h2>
      <dl>
        <dt>Parent &amp; Toddler</dt><dd>Age 1&ndash;3</dd>
        <dt>Preschool</dt><dd>Age 3&ndash;5</dd>
      </dl>
      <dl>
        <dt>Recreational 1</dt><dd>Beginner</dd>
        <dt>Recreational 2</dt><dd>Beginner Plus</dd>
        <dt>Recreational 3</dt><dd>Intermediate</dd>
        <dt>Recreational 4</dt><dd>Advanced</dd>
      </dl>
    </section>

    <p class="chiplabel">Day</p>
    <div class="chips" id="dayChips" role="group" aria-label="Filter by day"></div>
    <p class="chiplabel">Class type</p>
    <div class="chips" id="chips" role="group" aria-label="Filter by class type"></div>
    <p class="class-info" id="classInfo" aria-live="polite"></p>

    <div id="sessions" class="sessions-end"></div>

    <section class="mine" id="mine" hidden>
      <h2>Your classes</h2>
      <p class="sub">Saved on this device.</p>
      <ul id="mineList"></ul>
    </section>
    </div>

    <div id="paneAbout" role="tabpanel" aria-labelledby="tabAbout" hidden>
      <section class="pagehead">
        <h1>About us</h1>
        <p>Glasgow Gymnastics Academy is a gymnastics club in Thornliebank, Glasgow. Classes run seven days a week, from Parent &amp; Toddler and Preschool through recreational classes, squads and acro.</p>
      </section>
      <section class="contact" aria-labelledby="contactTitle">
        <h2 id="contactTitle">Find and contact us</h2>
        <div class="crow">
          <span class="k">Address</span>
          <address class="v" id="c-address">4B Burnfield Avenue, Thornliebank, Glasgow G46 7TL</address>
          <span class="acts"><a class="btn sm ghost" href="https://www.google.com/maps/search/?api=1&amp;query=4B+Burnfield+Avenue+Thornliebank+Glasgow+G46+7TL" target="_blank" rel="noopener">Open in Maps</a></span>
        </div>
        <div class="crow">
          <span class="k">Phone</span>
          <span class="v"><a href="tel:01412374248" id="c-phone">0141 237 4248</a></span>
          <span class="acts"><button type="button" class="btn sm ghost" data-copy="c-phone" data-text="0141 237 4248">Copy</button></span>
        </div>
        <div class="crow">
          <span class="k">Email</span>
          <span class="v"><a href="mailto:glasgowgymnasticsacademy@outlook.com" id="c-email">glasgowgymnasticsacademy@outlook.com</a></span>
          <span class="acts"><button type="button" class="btn sm ghost" data-copy="c-email" data-text="glasgowgymnasticsacademy@outlook.com">Copy</button></span>
        </div>
        <div class="crow">
          <span class="k">Instagram</span>
          <span class="v"><a href="https://www.instagram.com/glasgowgymnasticsacademy/" target="_blank" rel="noopener">@glasgowgymnasticsacademy</a></span>
          <span class="acts"></span>
        </div>
      </section>
    </div>
  </div>
</main>

<dialog id="dlg" aria-labelledby="dlgTitle">
  <div class="dlg" id="viewForm">
    <div class="dlg-head">
      <h2 id="dlgTitle">Book a place</h2>
      <button type="button" class="x" id="closeA" aria-label="Close">&#10005;</button>
    </div>
    <p class="sum" id="sum"></p>
    <form id="form" novalidate>
      <div class="fields">
        <div class="field">
          <label for="f-child">Gymnast's full name</label>
          <input type="text" id="f-child" autocomplete="off" placeholder="First and last name" autofocus>
          <p class="err" id="e-child"></p>
        </div>
        <div class="field">
          <label for="f-age">Gymnast's age</label>
          <input type="number" id="f-age" inputmode="numeric" min="1" max="99">
          <p class="err" id="e-age"></p>
        </div>
        <div class="field full">
